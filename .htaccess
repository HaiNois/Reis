# ============================================================================
# Reis E-commerce Platform - .htaccess Configuration
# Place this file in the public_html/ root directory
# ============================================================================

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ========================================================================
  # 1. Security Headers
  # ========================================================================
  # Prevent directory listing
  Options -Indexes

  # ========================================================================
  # 2. Compression
  # ========================================================================
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
  </IfModule>

  # ========================================================================
  # 3. Caching (1 year for versioned assets, 24 hours for HTML)
  # ========================================================================
  <IfModule mod_expires.c>
    ExpiresActive On

    # Cache versioned assets (bundled JS/CSS with hash)
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # Cache HTML for 24 hours
    ExpiresByType text/html "access plus 1 day"

    # Default
    ExpiresDefault "access plus 2 days"
  </IfModule>

  # ========================================================================
  # 4. CORS Headers (if needed for R2 assets)
  # ========================================================================
  <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # ========================================================================
  # 5. SPA Routing (React Router)
  # ========================================================================
  # Skip actual files and directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Rewrite all non-file/non-directory requests to index.html
  RewriteRule ^(.*)$ index.html [L]

  # ========================================================================
  # 6. API Proxy to Backend Node.js (Optional - if using path-based)
  # ========================================================================
  # If backend runs on localhost:3000 and you want /api/* to proxy there
  # ENABLE THIS ONLY IF MOD_PROXY IS AVAILABLE (check with hosting provider)
  # Typically works on cPanel VPS but may not on shared hosting

  # <IfModule mod_proxy.c>
  #   ProxyPreserveHost On
  #   ProxyPassMatch ^/api/(.*) http://localhost:3000/api/$1
  #   ProxyPassReverse ^/api/(.*) http://localhost:3000/api/$1
  # </IfModule>

  # ========================================================================
  # 7. Redirect HTTP to HTTPS
  # ========================================================================
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ========================================================================
  # 8. Remove www. prefix (optional - choose A or B)
  # ========================================================================
  # Option A: Force NO www
  # RewriteCond %{HTTP_HOST} ^www\.
  # RewriteRule ^(.*)$ https://%{HTTP_HOST:4}%{REQUEST_URI} [L,R=301]

  # Option B: Force www
  # RewriteCond %{HTTP_HOST} !^www\.
  # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

</IfModule>

# ============================================================================
# Security Headers (cPanel - check if supported)
# ============================================================================
<IfModule mod_headers.c>
  # Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # Prevent MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Enable XSS protection
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer policy
  Header always set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>

# ============================================================================
# Charset UTF-8
# ============================================================================
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddCharset UTF-8 .css .js .json .xml .md
</IfModule>
