# ==============================================================================
# Reis Backend - Production .env (Hostinger cPanel Business + MySQL)
# ------------------------------------------------------------------------------
# Copy these values into the cPanel Node.js App "Environment Variables" panel
# (DO NOT upload this file to the server — cPanel manages env vars itself).
# ==============================================================================

NODE_ENV=production

# Hostinger Node.js App auto-assigns PORT — leave 3000 as a fallback only.
# Passenger ignores PORT and uses its own socket; safe to keep.
PORT=3000

# ----- Database (MySQL on Hostinger) ------------------------------------------
# Create via cPanel -> Databases -> MySQL Databases.
# Username and DB name are auto-prefixed with your cPanel user, e.g. u123_reis.
# Format: mysql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="mysql://u602398354_reisdev:Hai220299@localhost:3306/u602398354_reisdev"

# ----- JWT secrets (32+ chars each, random) -----------------------------------
# Generate fresh ones — DO NOT reuse dev secrets.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARS_MIN_32
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARS_MIN_32
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARS_MIN_32
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ----- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_ADMIN_MAX_REQUESTS=1000

# ----- CORS -------------------------------------------------------------------
# Path-based deploy: same origin, but env still requires a URL — set to the
# public site so any cross-origin tool (e.g. Postman web) is rejected.
CORS_ORIGIN=https://reis-sg.online

# ----- R2 / Cloudflare --------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_TOKEN=
R2_BUCKET_NAME=reis-official
R2_PUBLIC_URL=https://pub-fd6649debd57401ba525852f2c862112.r2.dev

# ----- GHTK -------------------------------------------------------------------
GHTK_API_TOKEN=

# ----- PayPal (REQUIRED in production — env validation will refuse to start) -
# Switch to live credentials when ready. Webhook ID from PayPal Developer
# Dashboard -> My Apps & Credentials -> Webhooks -> select live webhook.
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
